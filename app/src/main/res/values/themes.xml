<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; colors and typography are handled in Compose (ui/theme). -->
    <style name="Theme.Pods" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/system_neutral1_10</item>
    </style>

    <!-- Transparent window for the connection bottom sheet; the sheet draws its own scrim. -->
    <style name="Theme.Pods.Popup" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
