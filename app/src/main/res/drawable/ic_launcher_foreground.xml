<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher icon: a pair of earbuds, heads facing each other, stems splayed outwards.
    Each bud = oval head with a speaker grille cut out + stem with a separate mic tip.
    Drawn once in local coordinates (head centre at 0,0), mirrored for the right bud.
    Colors follow Material You (wallpaper accent).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left bud -->
    <group
        android:translateX="41"
        android:translateY="41"
        android:scaleX="0.98"
        android:scaleY="0.98"
        android:rotation="12">
        <path
            android:fillColor="@android:color/system_accent1_700"
            android:fillType="evenOdd"
            android:pathData="M-12,0a12,11 0,1 0,24 0a12,11 0,1 0,-24 0z M2,-3a4,2.6 0,1 0,8 0a4,2.6 0,1 0,-8 0z" />
        <path
            android:fillColor="@android:color/system_accent1_700"
            android:pathData="M-7,8a4,4 0,0 1,8 0V30H-7Z" />
        <path
            android:fillColor="@android:color/system_accent1_700"
            android:pathData="M-7,31.5H1V32a4,4 0,0 1,-8 0Z" />
    </group>

    <!-- Right bud: same drawing, mirrored -->
    <group
        android:translateX="67"
        android:translateY="41"
        android:scaleX="-0.98"
        android:scaleY="0.98"
        android:rotation="-12">
        <path
            android:fillColor="@android:color/system_accent1_700"
            android:fillType="evenOdd"
            android:pathData="M-12,0a12,11 0,1 0,24 0a12,11 0,1 0,-24 0z M2,-3a4,2.6 0,1 0,8 0a4,2.6 0,1 0,-8 0z" />
        <path
            android:fillColor="@android:color/system_accent1_700"
            android:pathData="M-7,8a4,4 0,0 1,8 0V30H-7Z" />
        <path
            android:fillColor="@android:color/system_accent1_700"
            android:pathData="M-7,31.5H1V32a4,4 0,0 1,-8 0Z" />
    </group>
</vector>
